{
  "name": "bedrock-prompt-evals",
  "version": "1.0.0",
  "private": true,
  "description": "CDK harness for evaluating prompts on Amazon Bedrock (Prompt Management + Evaluation Jobs). One prompt per directory under prompts/.",
  "scripts": {
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy --force",
    "diff": "cdk diff"
  },
  "devDependencies": {
    "aws-cdk": "^2.1140.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.9.0"
  }
}
